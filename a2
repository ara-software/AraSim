// Setup file for 20231122 EVENT_TYPE=20 sims/testing
//
//////////////////////////////////////////////////////////

EVENT_TYPE=20             // 20 : Will read in electric field for each antenna
EXT_EFIELD_DIR= /home/ashoukat/CRsearches/araSim/good_geom/efields         // Directory containing electric fields
EXT_EFIELD_TSHIFT=1300    // Amount to shift time trace in ns (ideally 
                          //   centering interesting part of Efield at t=0)
WAVEFORM_LENGTH=7000 //64/2*(20*4) //7000      // Length of waveform read into V_mimic://1664 
                          //   Samples per block /
                          //   samples per waveform value * blocks
NFOUR=8196  //8192              // Directly proportional to how much efield is read in(previously it was 4096)
ANT_SIGNAL_THRESHOLD=1e-9 // volts
WAVEFORM_CENTER=2000

ATA_BIN_SIZE=5000
FILL_TREE_MODE=0     // default 0 : fill tree for all events,
                     // 1 : fill tree only usable posnu events,
                     // 2 : fill tree only trigger passed events

V_SATURATION=2.0      //voltage saturation set at 2.0
DATA_SAVE_MODE=0     // 0 : save all generated information
                     // 1 : light mode, remove most of data before final trigger
                     //     (most of data except geometric info, final data,
                     //      V_mimic will be removed).
                     // 2 : light mode 2, except for physics information
                     //     (energy, geometric info), all waveform information
                     //     are removed (include trigger class noise waveforms)

// ARA02 Setting
DETECTOR=4           // ARA Stations
DETECTOR_STATION=2   // Build Station 2
TIMESTEP=5.0E-10 //2.4E-10 //2.46E-10(max amplitudes) //2.260628111834535E-10  // ARA02 timestep from Myoungchul 5.00E-10 (i set 3.125E-10) 
TRIG_SCAN_MODE=1     // Faster triggering mode
TRIG_MODE=1          // use vpol, hpol separated trigger mode.
N_TRIG_V=3           // Need 3 VPols to trigger via VPol channel
N_TRIG_H=3           // Need 3 HPols to trigger via HPol channel
TRIG_WINDOW=1.7E-7   // 170 ns, from Myoungchul: 1.7E-7
POWERTHRESHOLD=-6.50 // From Myoungchul 6.6
DETECTOR_STATION_LIVETIME_CONFIG=6 
#number_of_stations=1 // Number of PA stations to build in hexagonal array
DETECTOR_STATION_LIVETIME_CONFIG=6 
  // 1: Runs    0-1745 ( 01/01/2018 - 12/31/2018 )
  // 2: Runs 1745-3835 ( 01/01/2019 - 12/31/2019 )
  // 3: Runs 3836-4021 ( 01/01/2020 - 03/25/2020 )
  // 4: Runs 4022-5928 ( 03/26/2020 - 12/31/2020 )
  // 5: Runs 5929-     ( 01/01/2021 - present    )


// Detector settings for all detectors
ANTENNA_MODE=5
  // 4: use the chiba in-situ models (treats top and bottom as the same)
CORE_X = 10000       // X location of center of detector
CORE_Y = 10000       // Y location of center of detector
READGEOM=0           // 0: Do not read geometry information from the sqlite file


// ICE
NOFZ=1               // 1=depth dependent index of refraction,0=off
RAY_TRACE_ICE_MODEL_PARAMS=40 // UNL Modified (PA model).


// Major Neutrino Settings
NNU=1               // number of neutrino events
EXPONENT=1           // dNdEdAdt ~ E^-1
EXPONENT_MAX=21.0    // maximum log10(eV) of Neutrino energy spectrum
POSNU_RADIUS=80000   // Max neutrino generation distance from detector
RAYSOL_RANGE=80000   // Max distance from detector to solve rays
MAX_POSNU_DEPTH=2800 // Max depth of neutrinos


//ADDED PRIMARY AND SHOWER FROM A23 SETTINGS: (inherited from Kaeli)
NU_NUBAR_SELECT_MODE=3 // random
SELECT_FLAVOR=0        // random 1:1:1 ratio
SELECT_CURRENT=2       // rndom nc or cc
SECONDARIES=1          // enable secondaries
TAUDECAY=1             // account for tau decay in secondaries
SHOWER_MODE=2          // both EM and hadronic shower in t-domain signal
INTERACTION_MODE=1     // Veff cylinder mode
SIGMA_SELECT=0         // cross section(0=nominal, 1=upper bound, 2=lower bound)


// NOISE
TRIG_ANALYSIS_MODE=0 //was 0 before           // 0=signal+noise, 1=signal only, 2=noise only
NOISE=1                        // Use Rayleigh Distribution
NOISE_EVENTS=1                 // number of stored noise events
NOISE_WAVEFORM_GENERATE_MODE=0 // generate new noise waveforms for each events
NOISE_CHANNEL_MODE=1
  // if using same noise temp for all chs (0, default), 
  // using diff temp for all chs (1),
  // using diff temp for first 8 chs and share same temp for other chs (2),
  // using same noise temp but allowing to use noise


// Random
RANDOM_MODE=0          // Will use seed specified in settings1->SEED
SEED=777
